autoload -U promptinit
promptinit

# fpath の重複を除去（sheldon 等が同じディレクトリを複数回追加するため）
typeset -U fpath

# compinit を sheldon 読み込み前に走らせる
# （carapace / gibo-completion 等が source 中に compdef を呼ぶため）
# .zcompdump が24時間以内に更新されていればセキュリティ監査(compaudit)をスキップして高速化
autoload -Uz compinit
zcompdump="${ZDOTDIR:-$HOME}/.zcompdump"
zcompdump_stale=( ${zcompdump}(Nmh+24) )
if [[ ! -e $zcompdump ]] || (( $#zcompdump_stale )); then
	compinit
else
	compinit -C
fi
unset zcompdump zcompdump_stale

# sheldon でプラグインを読み込み（設定は ~/.config/sheldon/plugins.toml）
if command -v sheldon &>/dev/null; then
	eval "$(sheldon source)"
fi

# alias設定
[ -f ~/.zsh/alias.zsh ] && source ~/.zsh/alias.zsh

# オプション・カスタマイズ設定
[ -f ~/.zsh/custom.zsh ] && source ~/.zsh/custom.zsh

# OS毎の設定
case "${OSTYPE}" in
darwin*)
	# Mac(Unix)
	[ -f ~/.zsh/osx.zsh ] && source ~/.zsh/osx.zsh
	;;
linux*)
	# Linux
	[ -f ~/.zsh/linux.zsh ] && source ~/.zsh/linux.zsh
	;;
esac

# Go の GOPATH は明示しなくても Go 1.11+ で $HOME/go がデフォルト。
# bin だけ PATH に通す。
if command -v go &>/dev/null; then
	export PATH="$PATH:$HOME/go/bin"
fi

# Load starship
eval "$(starship init zsh)"

# mise で Ruby / Python / Node 等のバージョンマネージャを統合
# (旧 rbenv / pyenv / nvm の役割を一括で代替)
if command -v mise &>/dev/null; then
	eval "$(mise activate zsh)"
fi

# zoxide で frecency ベースのディレクトリジャンプ
# （旧 rupa/z の代替。`z <キーワード>` でジャンプできる）
if command -v zoxide &>/dev/null; then
	eval "$(zoxide init zsh)"
fi

# Load direnv
if type direnv >/dev/null 2>&1; then
	eval "$(direnv hook zsh)"
fi

## local固有設定を読み込み
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

### MANAGED BY RANCHER DESKTOP START (DO NOT EDIT)
export PATH="{{ .chezmoi.homeDir }}/.rd/bin:$PATH"
### MANAGED BY RANCHER DESKTOP END (DO NOT EDIT)

# >>> herdr-revive >>>
# Resume the coding agent a herdr terminal lost to a restart or reboot.
# REVIVE_DEBUG=1 says why it did or didn't.
if [ -n "$HC_TERMINAL_ID" ] && [ -f {{ .chezmoi.homeDir }}/.config/herdr-app/mods/revive/revive.mjs ] && command -v node >/dev/null 2>&1; then
  __revive_j="$("${REVIVE_HC:-hc}" get "$HC_TERMINAL_ID" --json 2>/dev/null)"
  case "$__revive_j" in *'"revive.session"'*) __revive_has=1 ;; *) __revive_has= ;; esac
  case "$__revive_j" in *'"pid":'"$$"','*|*'"pid": '"$$"','*) __revive_own=1 ;; *) __revive_own= ;; esac
  if [ -z "$__revive_has" ]; then
    if [ -n "$REVIVE_DEBUG" ]; then echo "revive: nothing remembered on $HC_TERMINAL_ID" >&2; fi
  elif [ -z "$__revive_own" ]; then
    if [ -n "$REVIVE_DEBUG" ]; then echo "revive: not the terminal's own shell" >&2; fi
  else
    if [ -n "$REVIVE_DEBUG" ]; then __revive="$(node {{ .chezmoi.homeDir }}/.config/herdr-app/mods/revive/revive.mjs check --shell $$)"
    else __revive="$(node {{ .chezmoi.homeDir }}/.config/herdr-app/mods/revive/revive.mjs check --shell $$ 2>/dev/null)"; fi
    if [ -z "$__revive" ]; then unset __revive
    elif [ -n "$ZSH_VERSION" ]; then
      __revive_run() { add-zsh-hook -d precmd __revive_run; eval "$__revive"; unset __revive; unfunction __revive_run; }
      autoload -Uz add-zsh-hook && add-zsh-hook precmd __revive_run
    elif [ -n "$BASH_VERSION" ]; then
      __revive_run() { PROMPT_COMMAND="${PROMPT_COMMAND#__revive_run;}"; eval "$__revive"; unset __revive; unset -f __revive_run; }
      PROMPT_COMMAND="__revive_run;${PROMPT_COMMAND}"
    else eval "$__revive"; unset __revive; fi
  fi
  unset __revive_j __revive_has __revive_own
fi
# <<< herdr-revive <<<
